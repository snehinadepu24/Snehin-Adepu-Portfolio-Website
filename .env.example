# ─────────────────────────────────────────────────────────────
# Ask Snehin — Environment Variables
# ─────────────────────────────────────────────────────────────

# Google Gemini API Key (Get free key from https://aistudio.google.com/apikey)
# Used server-side only for Ask Snehin fallback responses.
# Note: Ask Snehin works immediately without an API key using the 40+ FAQ database + local semantic search.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Specify model (Defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
